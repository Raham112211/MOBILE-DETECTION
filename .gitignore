# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Model weights (Large files > 100MB; RF-DETR auto-downloads weights)
backend/models/*.pth
backend/models/*.pt
backend/models/*.onnx
backend/models/*.bin

# Video data outputs & user uploads (keeps sample.mp4)
backend/data/outputs/*
!backend/data/outputs/.gitkeep
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# Environment variables & IDE
.env
.env.local
.vscode/
.idea/
*.log
